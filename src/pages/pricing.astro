---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import "../styles/app.css";
import pricingData from "../data/pricing.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  getFaqSchema,
  SITE_URL,
} from "../utils/schema";

const { hero, plans, afterLaunch, faq, bottomCta, sectionOrder } = pricingData;

const pricingFaqSchema = getFaqSchema(faq.items);

const pricingSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: pricingData.seo.title,
    description: pricingData.seo.description,
    url: `${SITE_URL}/pricing`,
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Pricing", url: "/pricing" },
  ]),
  pricingFaqSchema,
]);
---

<BaseLayout title={pricingData.seo.title} description={pricingData.seo.description} schema={pricingSchema}>
  <Header />
  <main class="flex-1">

    {sectionOrder.map((sectionId) => {
      if (sectionId === "hero" && hero.visible) return (
        <section class="section-pad bg-canvas">
          <div class="container-content max-w-3xl">
            <p class="eyebrow mb-3 reveal">{hero.eyebrow}</p>
            <h1 class="mb-4 reveal">{hero.heading}</h1>
            <p class="text-ink-soft text-lg leading-relaxed reveal">
              {hero.body}
            </p>
          </div>
        </section>
      );

      if (sectionId === "plans" && plans.visible) return (
        <section class="section-pad bg-canvas-deep">
          <div class="container-content">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
              {plans.items.map((plan, i) => (
                <div class:list={[
                  "bg-card flex flex-col p-8",
                  plan.highlighted
                    ? "border-2 border-blue rounded-2xl relative shadow-lg"
                    : "border border-line rounded-2xl",
                  `reveal stagger-${i + 1}`
                ]}>
                  {plan.highlighted && plan.highlightBadge && (
                    <span class="absolute -top-3 left-6 badge text-blue border-blue/40 bg-canvas font-bold px-3 py-1 shadow-sm">{plan.highlightBadge}</span>
                  )}
                  <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">{plan.label}</p>
                  <h2 class="font-display text-2xl font-bold mb-1">{plan.name}</h2>
                  <div class="flex items-baseline gap-2 mb-1">
                    <span class:list={["numeral", plan.id === "custom" ? "text-2xl text-gold" : "text-3xl text-blue"]}>{plan.price}</span>
                    {plan.id !== "custom" && <span class="font-mono text-xs text-ink-soft">{plan.priceLabel}</span>}
                  </div>
                  {plan.id === "custom" && <p class="font-mono text-xs text-ink-soft mb-6">{plan.priceLabel}</p>}
                  <p class="text-ink-soft text-sm leading-relaxed mb-6">
                    {plan.description}
                  </p>
                  <div class="border-t border-line pt-5 mb-6">
                    <p class="font-display font-bold text-sm mb-3">Includes:</p>
                    <ul class="text-ink-soft text-sm leading-relaxed space-y-2.5">
                      {plan.features.map(feature => (
                        <li class="flex items-start gap-2">
                          <span class="text-up mt-0.5 flex-shrink-0 font-bold">✓</span>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="mt-auto pt-4 border-t border-line space-y-2">
                    <p class="text-xs font-mono text-ink-soft">Timeline: {plan.timeline}</p>
                    <p class="text-xs font-mono text-ink-soft">Payment: {plan.payment}</p>
                    {plan.footnote && (
                      <p class="text-ink-soft text-xs leading-relaxed mt-3 pt-3 border-t border-line">{plan.footnote}</p>
                    )}
                    <a href={plan.ctaHref} class="btn btn-primary w-full justify-center mt-4">{plan.ctaText}</a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "afterLaunch" && afterLaunch.visible) return (
        <section class="section-pad bg-canvas">
          <div class="container-content max-w-3xl">
            <div class="bg-card border border-line rounded-2xl p-8 md:p-10 reveal">
              <p class="eyebrow mb-3">{afterLaunch.eyebrow}</p>
              <h2 class="mb-4">{afterLaunch.heading}</h2>
              <p class="text-ink-soft text-base leading-relaxed">
                {afterLaunch.body}
              </p>
            </div>
          </div>
        </section>
      );

      if (sectionId === "faq" && faq.visible) return (
        <section class="section-pad bg-canvas-deep">
          <JsonLd schema={pricingFaqSchema} />
          <div class="container-content max-w-3xl">
            <p class="eyebrow mb-3 reveal">{faq.eyebrow}</p>
            <h2 class="mb-10 reveal">{faq.heading}</h2>
            <div class="flex flex-col gap-4">
              {faq.items.map((item, i) => (
                <details class={`bg-card border border-line rounded-2xl p-6 group reveal stagger-${(i % 3) + 1} cursor-pointer`}>
                  <summary class="font-display font-bold text-lg flex justify-between items-center select-none list-none [&::-webkit-details-marker]:hidden">
                    <span>{item.q}</span>
                    <span class="text-blue font-mono text-xl transition-transform duration-200 group-open:rotate-45 ml-4 flex-shrink-0">+</span>
                  </summary>
                  <p class="text-ink-soft text-sm leading-relaxed mt-4 pt-4 border-t border-line">
                    {item.a}
                  </p>
                </details>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "bottomCta" && bottomCta.visible) return (
        <section class="section-pad bg-canvas">
          <div class="container-content max-w-2xl text-center reveal">
            <h2 class="mb-4">{bottomCta.heading}</h2>
            <p class="text-ink-soft text-sm leading-relaxed mb-8">
              {bottomCta.body}
            </p>
            <a href={bottomCta.ctaHref} class="btn btn-primary">{bottomCta.ctaText}</a>
          </div>
        </section>
      );

      return null;
    })}

  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal observer
  const revealElements = document.querySelectorAll('.reveal, .reveal-scale');

  if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => {
      el.classList.add('revealed');
    });
  }
</script>
