---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

// Blog posts removed 2026-08-12 — content will be authored and published via CRM once built.
const posts: Array<{
  id: string;
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
}> = [];

const pageTitle = "GetUsRanked — SEO & Search Optimization Insights Blog";
const pageDesc = "GetUsRanked blog featuring expert SEO insights, local search tactics, e-commerce growth strategies, B2B lead generation guides, and AI search optimization techniques.";

const blogSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/blog`,
    type: "CollectionPage",
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog" },
  ]),
]);
---

<BaseLayout title={pageTitle} description={pageDesc} schema={blogSchema}>

  <Header />
  <main class="flex-1">

    <!-- Hero -->
    <section class="section-pad bg-canvas">
      <div class="container-content">
        <p class="eyebrow mb-3">GetUsRanked Blog</p>
        <h1 class="mb-4 max-w-2xl">Search Visibility & Growth Insights</h1>
        <p class="text-ink-soft text-lg max-w-2xl leading-relaxed">
          In-depth SEO playbooks, local search strategies, e-commerce growth tactics, and AI search optimization (AEO/GEO) written by our senior SEO agency specialists.
        </p>
      </div>
    </section>

    <!-- Main Section (Posts / Empty State) -->
    <section class="section-pad bg-canvas-deep">
      <div class="container-content">

        {posts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {posts.map(post => (
              <article class="bg-card border border-line rounded-2xl p-6 flex flex-col hover:border-blue/50 transition-colors group">
                <div class="flex items-center justify-between mb-4">
                  <span class="badge text-blue border-blue/30">{post.category}</span>
                  <span class="font-mono text-xs text-ink-soft/60">{post.readTime}</span>
                </div>
                <h2 class="font-display text-lg font-bold mb-3 leading-snug group-hover:text-blue transition-colors">
                  <a href={`/blog/${post.id}`} class="text-ink hover:text-blue no-underline">
                    {post.title}
                  </a>
                </h2>
                <p class="text-ink-soft text-sm leading-relaxed flex-1 mb-6">{post.excerpt}</p>
                <div class="flex items-center justify-between pt-4 border-t border-line">
                  <span class="font-mono text-xs text-ink-soft/60">{post.date}</span>
                  <a href={`/blog/${post.id}`} class="font-mono text-xs text-blue uppercase tracking-wider font-semibold inline-flex items-center gap-1 hover:underline">
                    Read Article →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="bg-card border border-line rounded-2xl p-8 sm:p-12 text-center max-w-3xl mx-auto shadow-sm">
            <div class="w-12 h-12 rounded-full bg-blue/10 text-blue flex items-center justify-center mx-auto mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l5 5v11a2 2 0 01-2 2z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="12" y1="18" x2="12" y2="12"></line>
                <line x1="9" y1="15" x2="15" y2="15"></line>
              </svg>
            </div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold mb-4 text-ink">New Content Coming Soon</h2>
            <p class="text-ink-soft text-base leading-relaxed mb-8 max-w-xl mx-auto">
              We're building out our SEO and AI-search insights, real case studies and practical guides, not filler. Check back soon, or get in touch if you have a question we can answer directly.
            </p>
            <div class="flex justify-center">
              <a href="/contact" class="btn btn-primary">Get in Touch</a>
            </div>
          </div>
        )}

        <!-- Consultation Banner -->
        <div class="mt-16 p-8 bg-card border border-line rounded-2xl text-center max-w-3xl mx-auto">
          <h3 class="font-display text-xl font-bold mb-3">Looking for a Performance-Driven SEO Agency?</h3>
          <p class="text-ink-soft text-sm leading-relaxed mb-6">
            We build high-converting WordPress and Shopify websites paired with modern technical SEO and AI search optimization.
          </p>
          <div class="flex justify-center gap-4 flex-wrap">
            <a href="/#contact" class="btn btn-primary text-xs">Request Free SEO Audit</a>
            <a href="/about-us" class="btn btn-ghost text-xs">About Our Agency</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

