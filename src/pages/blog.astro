---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const posts = [
  {
    category: "Technical SEO",
    title: "Why Your Website Isn't Ranking — And What to Fix First",
    excerpt: "Most ranking problems come from a handful of technical issues that are invisible to the business owner. Here's where to look and what to prioritize.",
    date: "Coming Soon",
    readTime: "8 min read",
  },
  {
    category: "Local SEO",
    title: "Local SEO in 2026: What Actually Moves the Needle",
    excerpt: "Google Business Profile optimization, local citations, and review strategy — the things that still drive local pack rankings, stripped of the noise.",
    date: "Coming Soon",
    readTime: "6 min read",
  },
  {
    category: "Process",
    title: "Technical Audits Demystified: What We Check and Why",
    excerpt: "A walk-through of our audit process — crawlability, Core Web Vitals, indexing, and content gaps — so you know exactly what you're getting.",
    date: "Coming Soon",
    readTime: "10 min read",
  },
  {
    category: "Content Strategy",
    title: "Content That Ranks: Beyond Keyword Stuffing",
    excerpt: "Search intent, topic clusters, and content depth — the principles behind content that earns rankings instead of chasing them.",
    date: "Coming Soon",
    readTime: "7 min read",
  },
  {
    category: "Reporting",
    title: "How We Track and Report Your SEO Progress",
    excerpt: "Ranking movement, traffic, conversions — what goes into our monthly reports and why we prioritize clarity over volume.",
    date: "Coming Soon",
    readTime: "5 min read",
  },
  {
    category: "Strategy",
    title: "The Real Timeline for SEO Results",
    excerpt: "SEO isn't overnight. Here's an honest breakdown of what to expect in months 1–3, 3–6, and beyond — and why the first months matter most.",
    date: "Coming Soon",
    readTime: "6 min read",
  },
];

const pageTitle = "Blog — GetUsRanked | SEO Insights & Strategy";
const pageDesc = "SEO insights, strategy breakdowns, and practical guides from the GetUsRanked team. Learn what actually moves search rankings.";

const blogSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/blog`,
    type: "CollectionPage",
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog" },
  ]),
]);
---

<BaseLayout title={pageTitle} description={pageDesc} schema={blogSchema}>

  <Header />
  <main class="flex-1">

    <!-- Hero -->
    <section class="section-pad bg-canvas">
      <div class="container-content">
        <p class="eyebrow mb-3">Blog</p>
        <h1 class="mb-4 max-w-xl">Insights & Strategy</h1>
        <p class="text-ink-soft text-lg max-w-xl leading-relaxed">
          Practical SEO knowledge — what works, what doesn't, and how we approach the work we do for our clients. No fluff, no jargon.
        </p>
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="section-pad bg-canvas-deep">
      <div class="container-content">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {posts.map(post => (
            <article class="bg-card border border-line rounded-[3px] p-6 flex flex-col">
              <div class="flex items-center justify-between mb-4">
                <span class="badge text-ink-soft">{post.category}</span>
                <span class="font-mono text-xs text-ink-soft/60">{post.readTime}</span>
              </div>
              <h3 class="font-display text-base font-bold mb-3 leading-snug">{post.title}</h3>
              <p class="text-ink-soft text-sm leading-relaxed flex-1 mb-6">{post.excerpt}</p>
              <div class="flex items-center justify-between pt-4 border-t border-line">
                <span class="font-mono text-xs text-ink-soft/50">{post.date}</span>
                <span class="font-mono text-xs text-blue uppercase tracking-wider">Coming Soon</span>
              </div>
            </article>
          ))}
        </div>

        <!-- Phase 2 note -->
        <div class="mt-12 text-center">
          <p class="text-ink-soft text-sm max-w-lg mx-auto leading-relaxed">
            Our blog is launching soon. These articles are in progress — subscribe to be notified when they go live.
          </p>
          <div class="mt-6 flex justify-center gap-4 flex-wrap">
            <a href="/#contact" class="btn btn-primary text-xs">Get Notified</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
