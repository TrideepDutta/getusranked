---
// This component must only render data from about data source. No hardcoded content allowed.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import aboutData from "../data/about.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getHowToSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const { hero, pillars, process, whatWeDontDo, cta, sectionOrder } = aboutData;

const aboutSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: aboutData.seo.title,
    description: aboutData.seo.description,
    url: `${SITE_URL}/about-us`,
    type: "AboutPage",
  }),
  getHowToSchema(process.steps),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "About Us", url: "/about-us" },
  ]),
]);
---

<BaseLayout title={aboutData.seo.title} description={aboutData.seo.description} schema={aboutSchema}>
  <Header />
  <main class="flex-1">

    {sectionOrder.map((sectionId) => {
      if (sectionId === "hero" && hero.visible) return (
        <section class="section-pad bg-canvas border-b border-line">
          <div class="container-content">
            <div class="max-w-3xl">
              <p class="eyebrow mb-3 reveal">{hero.eyebrow}</p>
              <h1 class="mb-6 reveal">{hero.heading}</h1>
              <p class="text-ink-soft text-xl leading-relaxed reveal">
                {hero.body}
              </p>
            </div>
          </div>
        </section>
      );

      if (sectionId === "pillars" && pillars.visible) return (
        <section class="section-pad bg-canvas-deep">
          <div class="container-content">
            <p class="eyebrow mb-3 reveal">{pillars.eyebrow}</p>
            <h2 class="mb-10 max-w-2xl reveal">{pillars.heading}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {pillars.items.map((pillar, i) => (
                <div class={`bg-card border border-line rounded-2xl p-6 reveal stagger-${i + 1}`}>
                  <h3 class="font-display text-lg font-bold mb-3">{pillar.title}</h3>
                  <p class="text-ink-soft text-sm leading-relaxed">{pillar.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "process" && process.visible) return (
        <section class="section-pad bg-canvas">
          <div class="container-content mb-12">
            <p class="eyebrow mb-3 reveal">{process.eyebrow}</p>
            <h2 class="max-w-2xl reveal">{process.heading}</h2>
          </div>

          {process.steps.map((step, i) => (
            <div class:list={["py-12 border-t border-line", i % 2 === 0 ? "bg-canvas-deep" : "bg-canvas"]}>
              <div class="container-content">
                <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-x-12 gap-y-4">
                  <div class="flex md:flex-col items-center md:items-start gap-3 md:w-32 reveal">
                    <span class="numeral text-5xl text-ink/15">{step.num}</span>
                    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">{step.label}</span>
                  </div>
                  <div class="reveal stagger-1">
                    <h3 class="font-display text-2xl font-bold mb-6">{step.title}</h3>
                    <div class="flex flex-col gap-4 max-w-2xl">
                      {step.paragraphs.map(p => (
                        <p class="text-ink-soft leading-relaxed">{p}</p>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </section>
      );

      if (sectionId === "whatWeDontDo" && whatWeDontDo.visible) return (
        <section class="section-pad bg-dark-section text-white">
          <div class="container-content">
            <p class="eyebrow eyebrow-light mb-3 reveal">{whatWeDontDo.eyebrow}</p>
            <h2 class="text-white mb-6 max-w-2xl reveal">{whatWeDontDo.heading}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {whatWeDontDo.items.map((item, i) => (
                <div class={`border border-white/10 rounded-2xl p-6 reveal stagger-${i + 1}`}>
                  <p class="font-display font-bold text-white text-lg mb-2">{item.title}</p>
                  <p class="text-white/70 text-sm leading-relaxed">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "cta" && cta.visible) return (
        <section class="section-pad bg-canvas-deep">
          <div class="container-content text-center reveal">
            <h2 class="mb-4">{cta.heading}</h2>
            <p class="text-ink-soft max-w-lg mx-auto mb-8 leading-relaxed">
              {cta.body}
            </p>
            <div class="flex flex-wrap justify-center gap-4">
              <a href={cta.primaryCta.href} class="btn btn-primary">{cta.primaryCta.text}</a>
              <a href={cta.secondaryCta.href} class="btn btn-ghost">{cta.secondaryCta.text}</a>
            </div>
          </div>
        </section>
      );

      return null;
    })}

  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal observer
  const revealElements = document.querySelectorAll('.reveal');

  if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => {
      el.classList.add('revealed');
    });
  }
</script>
