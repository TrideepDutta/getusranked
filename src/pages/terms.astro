---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import termsData from "../data/terms.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const termsSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: termsData.seo.title,
    description: termsData.seo.description,
    url: `${SITE_URL}/terms`,
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Terms & Conditions", url: "/terms" },
  ]),
]);
---

<BaseLayout title={termsData.seo.title} description={termsData.seo.description} schema={termsSchema}>

  <Header />
  <main class="flex-1">

    <section class="section-pad bg-canvas">
      <div class="container-content max-w-3xl">
        <p class="eyebrow mb-3">{termsData.eyebrow}</p>
        <h1 class="mb-4">{termsData.heading}</h1>
        <p class="text-ink-soft text-sm mb-10">Last updated: {termsData.lastUpdated}</p>

        <div class="flex flex-col gap-10">
          {termsData.sections.map(section => (
            <div>
              <h2 class="text-lg mb-3">{section.title}</h2>
              {section.body.split('\n\n').map(paragraph => (
                <p class="text-ink-soft leading-relaxed mb-3">{paragraph}</p>
              ))}
            </div>
          ))}

          <div class="border-t border-line pt-8 mt-4">
            <h2 class="text-lg mb-3">{termsData.contactSection.title}</h2>
            <p class="text-ink-soft leading-relaxed">
              {termsData.contactSection.body}{' '}
              <a href={`mailto:${termsData.contactSection.email}`} class="text-blue">{termsData.contactSection.email}</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
