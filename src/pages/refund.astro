---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import refundData from "../data/refund.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const refundSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: refundData.seo.title,
    description: refundData.seo.description,
    url: `${SITE_URL}/refund`,
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Refund Policy", url: "/refund" },
  ]),
]);
---

<BaseLayout title={refundData.seo.title} description={refundData.seo.description} schema={refundSchema}>

  <Header />
  <main class="flex-1">

    <section class="section-pad bg-canvas">
      <div class="container-content max-w-3xl">
        <p class="eyebrow mb-3">{refundData.eyebrow}</p>
        <h1 class="mb-4">{refundData.heading}</h1>
        <p class="text-ink-soft text-sm mb-10">Last updated: {refundData.lastUpdated}</p>

        <div class="flex flex-col gap-10">

          <!-- Guarantee Overview -->
          <div>
            <h2 class="text-lg mb-3">{refundData.guarantee.title}</h2>
            <p class="text-ink-soft leading-relaxed" set:html={refundData.guarantee.body.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
          </div>

          {refundData.sections.map(section => (
            <div>
              <h2 class="text-lg mb-3">{section.title}</h2>
              <p class="text-ink-soft leading-relaxed mb-3">{section.body}</p>
              {section.bullets && (
                <ul class="list-none flex flex-col gap-2 ml-0">
                  {section.bullets.map(bullet => (
                    <li class="text-ink-soft text-sm flex items-start gap-2">
                      <span class="text-blue mt-0.5 text-xs">•</span>
                      <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                    </li>
                  ))}
                </ul>
              )}
              {section.numberedList && (
                <ul class="list-none flex flex-col gap-2 ml-0">
                  {section.numberedList.map((item, i) => (
                    <li class="text-ink-soft text-sm flex items-start gap-2">
                      <span class="text-blue mt-0.5 text-xs">{i + 1}.</span>
                      <span set:html={item.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                    </li>
                  ))}
                </ul>
              )}
              {section.afterList && (
                <p class="text-ink-soft leading-relaxed mt-3" set:html={section.afterList.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
              )}
            </div>
          ))}

          <div class="border-t border-line pt-8 mt-4">
            <h2 class="text-lg mb-3">{refundData.contactSection.title}</h2>
            <p class="text-ink-soft leading-relaxed">
              {refundData.contactSection.body}{' '}
              <a href={`mailto:${refundData.contactSection.email}`} class="text-blue">{refundData.contactSection.email}</a>.
            </p>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
