---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/JsonLd.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  getFaqSchema,
  SITE_URL,
} from "../utils/schema";

const pricingFaqs = [
  {
    q: "Do you guarantee these keywords will rank?",
    a: "No. We optimize your site to target and compete for the keyword count listed in each plan, honestly and with sustainable methods. No agency can guarantee a ranking position; anyone who promises that isn't being straight with you.",
  },
  {
    q: "What if my project doesn't fit any of these three plans?",
    a: "Reach out and we'll talk about it. Not every business fits neatly into 5, 10, or \"custom\" pages, and that's fine.",
  },
  {
    q: "What's not included?",
    a: "Ongoing content creation or link building after launch, paid ad management, and any custom feature not explicitly listed above. These are available separately.",
  },
  {
    q: "Can I upgrade later?",
    a: "Yes. Start with Starter or Growth and move up when you're ready. You're not locked into the tier you begin with.",
  },
];

const pageTitle = "GetUsRanked — Packages & Pricing";
const pageDesc =
  "Simple pricing. Three ways to work with GetUsRanked — Starter, Growth, and Custom plans for WordPress and Shopify sites with SEO and AI-search visibility built in.";

const pricingFaqSchema = getFaqSchema(pricingFaqs);

const packagesSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/packages`,
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Packages", url: "/packages" },
  ]),
  pricingFaqSchema,
]);
---

<BaseLayout title={pageTitle} description={pageDesc} schema={packagesSchema}>

  <Header />
  <main class="flex-1">

    <!-- ═══════ HERO ═══════ -->
    <section class="section-pad bg-canvas">
      <div class="container-content max-w-3xl">
        <p class="eyebrow mb-3 reveal">Packages</p>
        <h1 class="mb-4 reveal">Simple pricing. Three ways to work with us.</h1>
        <p class="text-ink-soft text-lg leading-relaxed reveal">
          No hidden costs, no vague "contact for quote" on the plans that don't need it. Pick what fits, or reach out if your project doesn't fit a box.
        </p>
      </div>
    </section>

    <!-- ═══════ PLAN CARDS ═══════ -->
    <section class="section-pad bg-canvas-deep">
      <div class="container-content">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

          <!-- Starter -->
          <div class="bg-card border border-line rounded-2xl p-8 flex flex-col reveal stagger-1">
            <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">Plan 1</p>
            <h2 class="font-display text-2xl font-bold mb-1">Starter</h2>
            <p class="numeral text-3xl text-blue mb-1">$599</p>
            <p class="font-mono text-xs text-ink-soft mb-6">one-time</p>
            <p class="text-ink-soft text-sm leading-relaxed mb-6">
              For businesses that need a real website live fast, with SEO done right from day one.
            </p>
            <div class="border-t border-line pt-5 mb-6">
              <p class="font-display font-bold text-sm mb-3">Includes:</p>
              <ul class="text-ink-soft text-sm leading-relaxed space-y-2">
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>WordPress site, up to 5 pages</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Mobile-optimized, fast-loading build</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>On-page SEO setup, optimized for up to 10 target keywords</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>AEO-ready FAQ schema (structured for AI answer engines like ChatGPT and Perplexity, not just Google)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Basic technical SEO foundation (site speed, indexing, meta structure)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>2 rounds of revisions</span>
                </li>
              </ul>
            </div>
            <div class="mt-auto space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Timeline: ~2–3 weeks</span>
              </div>
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Payment: 50% upfront, 50% on delivery</span>
              </div>
              <a href="/contact" class="btn btn-primary w-full justify-center mt-4">Get Started</a>
            </div>
          </div>

          <!-- Growth -->
          <div class="bg-card border-2 border-blue rounded-2xl p-8 flex flex-col relative reveal stagger-2">
            <span class="absolute -top-3 left-6 badge text-blue border-blue/30 bg-card px-3 py-1">Most Popular</span>
            <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">Plan 2</p>
            <h2 class="font-display text-2xl font-bold mb-1">Growth</h2>
            <p class="numeral text-3xl text-blue mb-1">$899</p>
            <p class="font-mono text-xs text-ink-soft mb-6">one-time</p>
            <p class="text-ink-soft text-sm leading-relaxed mb-6">
              For businesses that need more site, more content structure, and a stronger SEO foundation to grow on.
            </p>
            <div class="border-t border-line pt-5 mb-6">
              <p class="font-display font-bold text-sm mb-3">Includes:</p>
              <ul class="text-ink-soft text-sm leading-relaxed space-y-2">
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>WordPress or standard website, up to 10 pages</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Everything in Starter, plus:</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>On-page SEO setup, optimized for up to 20 target keywords</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>AEO-ready FAQ schema across key pages</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Blog/content system set up and ready to publish into</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Deeper technical SEO (structured data, internal linking architecture, Core Web Vitals tuning)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>3 rounds of revisions</span>
                </li>
              </ul>
            </div>
            <div class="mt-auto space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Timeline: ~4–5 weeks</span>
              </div>
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Payment: 50% upfront, 50% on delivery</span>
              </div>
              <a href="/contact" class="btn btn-primary w-full justify-center mt-4">Get Started</a>
            </div>
          </div>

          <!-- Custom / Full-Stack -->
          <div class="bg-card border border-line rounded-2xl p-8 flex flex-col reveal stagger-3">
            <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-3">Plan 3</p>
            <h2 class="font-display text-2xl font-bold mb-1">Custom</h2>
            <p class="numeral text-3xl text-gold mb-1">Custom Pricing</p>
            <p class="font-mono text-xs text-ink-soft mb-6">scoped to your project</p>
            <p class="text-ink-soft text-sm leading-relaxed mb-6">
              For businesses that need a full custom build, not a template, with room to grow and manage things yourself.
            </p>
            <div class="border-t border-line pt-5 mb-6">
              <p class="font-display font-bold text-sm mb-3">Includes:</p>
              <ul class="text-ink-soft text-sm leading-relaxed space-y-2">
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>Custom website, WordPress or full-stack build, built to your exact requirements</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>On-page SEO setup, optimized for 40+ target keywords</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>AEO-ready structure sitewide</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>An analytics/CRM dashboard so you can edit posts, publish new blog content, or manage core site content yourself, without touching code</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-up mt-0.5 flex-shrink-0">✓</span>
                  <span>3 rounds of revisions</span>
                </li>
              </ul>
            </div>
            <div class="mt-auto space-y-3">
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Timeline: ~7–10 weeks</span>
              </div>
              <div class="flex items-center justify-between text-xs font-mono text-ink-soft">
                <span>Payment: 50% upfront, 50% on delivery</span>
              </div>
              <p class="text-ink-soft text-xs leading-relaxed mt-3 pt-3 border-t border-line">
                <strong class="text-ink">Need custom automation on top of this?</strong> (workflow automation, third-party integrations, booking/scheduling systems, or anything beyond the standard dashboard) — that's scoped and quoted separately, since every automation need is different. No fixed price here, we talk first.
              </p>
              <a href="/contact" class="btn btn-primary w-full justify-center mt-2">Connect With Us</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ AFTER LAUNCH ═══════ -->
    <section class="section-pad bg-canvas">
      <div class="container-content max-w-3xl">
        <div class="bg-card border border-line rounded-2xl p-8 reveal">
          <p class="eyebrow mb-3">After Launch</p>
          <h2 class="mb-4">What happens once your site is live</h2>
          <p class="text-ink-soft text-sm leading-relaxed">
            All three plans are one-time builds. Once your site is live, an <strong class="text-ink">optional monthly SEO retainer</strong> keeps your rankings moving and adapts as search and AI-search algorithms change. This isn't bundled into the build price. It's offered after launch, when you've seen the work and can decide if you want to keep going.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════ PRICING FAQ ═══════ -->
    <section class="section-pad bg-canvas-deep">
      <JsonLd schema={pricingFaqSchema} />
      <div class="container-content max-w-3xl">
        <p class="eyebrow mb-3 reveal">Pricing FAQ</p>
        <h2 class="mb-10 reveal">Common Questions</h2>
        <div class="flex flex-col gap-4">
          {pricingFaqs.map((faq, i) => (
            <details class={`bg-card border border-line rounded-2xl p-6 group reveal stagger-${(i % 3) + 1} cursor-pointer`}>
              <summary class="font-display font-bold text-lg flex justify-between items-center select-none list-none [&::-webkit-details-marker]:hidden">
                <span>{faq.q}</span>
                <span class="text-blue font-mono text-xl transition-transform duration-200 group-open:rotate-45 ml-4 flex-shrink-0">+</span>
              </summary>
              <p class="text-ink-soft text-sm leading-relaxed mt-4 pt-4 border-t border-line">
                {faq.a}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════ CTA ═══════ -->
    <section class="section-pad bg-canvas">
      <div class="container-content max-w-2xl text-center reveal">
        <h2 class="mb-4">Not sure which plan fits?</h2>
        <p class="text-ink-soft text-sm leading-relaxed mb-8">
          Reach out and we'll talk about your project. No commitment, no pressure.
        </p>
        <a href="/contact" class="btn btn-primary">Get a Free Site Review</a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal observer
  const revealElements = document.querySelectorAll('.reveal, .reveal-scale');

  if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => {
      el.classList.add('revealed');
    });
  }
</script>
