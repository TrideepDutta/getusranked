---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
} from "../utils/schema";

const popularLinks = [
  { label: "Home Page", href: "/", desc: "Return to our main landing page" },
  { label: "About Us & Process", href: "/about-us", desc: "Learn how we deliver rankable websites" },
  { label: "Agency Insights & Blog", href: "/blog", desc: "Read SEO & AI optimization guides" },
  { label: "Contact Us & Free Audit", href: "/contact", desc: "Get in touch with our strategy team" },
];

const pageSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: "GetUsRanked — 404 Page Not Found",
    description: "The page you are looking for could not be found on GetUsRanked.",
    url: "/404",
  }),
]);
---

<BaseLayout
  title="GetUsRanked — 404 Page Not Found"
  description="The page you were looking for could not be found. Explore our main pages or request a free site audit."
  schema={pageSchema}
>
  <Header />

  <main class="flex-grow flex flex-col justify-center section-pad">
    <div class="container-content">
      <div class="max-w-3xl mx-auto text-center reveal-scale">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-ink/5 border border-line rounded-full mb-6 font-mono text-xs text-ink-soft uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-blue animate-pulse"></span>
          HTTP Status 404 &mdash; Page Not Found
        </div>

        <!-- Big Orbitron Numeral -->
        <h1 class="numeral text-7xl sm:text-8xl md:text-9xl text-ink tracking-tight mb-4 select-none">
          4<span class="text-blue">0</span>4
        </h1>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-display text-ink mb-4">
          Page lost in index.
        </h2>

        <p class="text-ink-soft text-base md:text-lg max-w-xl mx-auto mb-8 leading-relaxed">
          The requested URL was not found on our server. It may have been moved, updated, or typed incorrectly.
        </p>

        <!-- CTA -->
        <div class="flex flex-wrap justify-center gap-4 mb-14">
          <a href="/" class="btn btn-primary">
            &larr; Back to Home
          </a>
        </div>

        <!-- Suggested Pages -->
        <div class="border-t border-line pt-12 text-left">
          <h3 class="eyebrow mb-6 text-center">Popular Destinations</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {popularLinks.map(link => (
              <a
                href={link.href}
                class="block p-5 bg-card hover:bg-canvas-deep border border-line hover:border-blue/40 rounded-2xl transition-all duration-200 no-underline group"
              >
                <div class="font-display font-semibold text-ink group-hover:text-blue transition-colors flex items-center justify-between">
                  <span>{link.label}</span>
                  <span class="text-ink-soft group-hover:text-blue group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
                <div class="text-ink-soft text-xs mt-1">
                  {link.desc}
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".reveal, .reveal-scale").forEach((el) => observer.observe(el));
</script>
