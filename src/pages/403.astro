---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
} from "../utils/schema";

const pageSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: "GetUsRanked — 403 Access Forbidden",
    description: "Access to this resource is forbidden on GetUsRanked.",
    url: "/403",
  }),
]);
---

<BaseLayout
  title="GetUsRanked — 403 Access Forbidden"
  description="You do not have permission to access this resource. Return to home or contact support."
  schema={pageSchema}
>
  <Header />

  <main class="flex-grow flex flex-col justify-center section-pad">
    <div class="container-content">
      <div class="max-w-3xl mx-auto text-center reveal-scale">
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-ink/5 border border-line rounded-full mb-6 font-mono text-xs text-ink-soft uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          HTTP Status 403 &mdash; Access Forbidden
        </div>

        <!-- Big Orbitron Numeral -->
        <h1 class="numeral text-7xl sm:text-8xl md:text-9xl text-ink tracking-tight mb-4 select-none">
          4<span class="text-red-500">0</span>3
        </h1>

        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold font-display text-ink mb-4">
          Access restricted.
        </h2>

        <p class="text-ink-soft text-base md:text-lg max-w-xl mx-auto mb-8 leading-relaxed">
          You don't have permission to access this route or directory. If you believe this is a mistake, please reach out to our team.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <a href="/" class="btn btn-primary">
            &larr; Back to Home
          </a>
          <a href="/contact" class="btn btn-ghost">
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const revealEls = document.querySelectorAll(".reveal, .reveal-scale");
  if (revealEls.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
          }
        });
      },
      { threshold: 0.05 }
    );
    revealEls.forEach((el) => observer.observe(el));
    setTimeout(() => {
      revealEls.forEach((el) => el.classList.add("revealed"));
    }, 300);
  }
</script>
