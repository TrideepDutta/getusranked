---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import privacyData from "../data/privacy.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const privacySchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: privacyData.seo.title,
    description: privacyData.seo.description,
    url: `${SITE_URL}/privacy`,
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Privacy Policy", url: "/privacy" },
  ]),
]);
---

<BaseLayout title={privacyData.seo.title} description={privacyData.seo.description} schema={privacySchema}>

  <Header />
  <main class="flex-1">

    <section class="section-pad bg-canvas">
      <div class="container-content max-w-3xl">
        <p class="eyebrow mb-3">{privacyData.eyebrow}</p>
        <h1 class="mb-4">{privacyData.heading}</h1>
        <p class="text-ink-soft text-sm mb-10">Last updated: {privacyData.lastUpdated}</p>

        <div class="flex flex-col gap-10">
          {privacyData.sections.map(section => (
            <div>
              <h2 class="text-lg mb-3">{section.title}</h2>
              <p class="text-ink-soft leading-relaxed mb-3">{section.body}</p>
              {section.bullets && (
                <ul class="list-none flex flex-col gap-2 ml-0">
                  {section.bullets.map(bullet => (
                    <li class="text-ink-soft text-sm flex items-start gap-2">
                      <span class="text-blue mt-0.5 text-xs">•</span>
                      <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
                    </li>
                  ))}
                </ul>
              )}
              {section.afterBullets && (
                <p class="text-ink-soft leading-relaxed mt-3">{section.afterBullets}</p>
              )}
            </div>
          ))}

          <div class="border-t border-line pt-8 mt-4">
            <h2 class="text-lg mb-3">{privacyData.contactSection.title}</h2>
            <p class="text-ink-soft leading-relaxed">
              {privacyData.contactSection.body}{' '}
              <a href={`mailto:${privacyData.contactSection.email}`} class="text-blue">{privacyData.contactSection.email}</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
