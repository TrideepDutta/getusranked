---
// This component must only render data from home data source. No hardcoded content allowed.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import homeData from "../data/home.json";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getHowToSchema,
  SITE_URL,
} from "../utils/schema";

const { hero, howWeThink, process, whyUs, credibility, closingCta, sectionOrder } = homeData;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const homeSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: homeData.seo.title,
    description: homeData.seo.description,
    url: `${SITE_URL}/`,
  }),
  getHowToSchema(process.steps),
]);
---

<BaseLayout title={homeData.seo.title} schema={homeSchema}>

  <Header />
  <main class="flex-1">

    {/* Render sections in CMS-defined order */}
    {sectionOrder.map((sectionId) => {
      if (sectionId === "hero" && hero.visible) return (
        <section id="hero" class="section-pad bg-canvas overflow-hidden">
          <div class="container-content">
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-12 items-center">
              <div class="reveal">
                <p class="eyebrow mb-4">{hero.eyebrow}</p>
                <h1 class="mb-6" set:html={hero.heading.replace(/\n/g, '<br />')} />
                <p class="text-ink-soft text-xl max-w-xl mb-10 leading-relaxed">
                  {hero.subheading}
                </p>
                <div class="flex flex-wrap gap-4">
                  <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.text}</a>
                  <a href={hero.secondaryCta.href} class="btn btn-ghost">{hero.secondaryCta.text}</a>
                </div>
              </div>
              <div class="flex justify-center xl:justify-end reveal stagger-2">
                <div class="relative" style="transform: rotate(-2deg);">
                  <div class="glass-card border border-line-strong rounded-2xl p-8 w-72 text-center">
                    <p class="font-mono text-xs uppercase tracking-widest text-ink-soft mb-6">{hero.rankCard.label}</p>
                    <div class="flex items-center justify-center gap-4">
                      <span class="numeral text-6xl text-ink-soft/40">{hero.rankCard.fromRank}</span>
                      <svg class="w-6 h-6 text-up" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                      <span class="numeral text-6xl text-blue">{hero.rankCard.toRank}</span>
                    </div>
                    <p class="mt-6 text-up font-mono text-xs uppercase tracking-wider font-medium">
                      {hero.rankCard.footerText}
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      );

      if (sectionId === "howWeThink" && howWeThink.visible) return (
        <section id="how-we-think" class="section-pad bg-canvas-deep">
          <div class="container-content">
            <p class="eyebrow mb-3 reveal">{howWeThink.eyebrow}</p>
            <h2 class="mb-10 max-w-2xl reveal">{howWeThink.heading}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {howWeThink.items.map((item, i) => (
                <div class={`bg-card border border-line rounded-2xl p-6 reveal stagger-${i + 1}`}>
                  <h3 class="font-display text-lg font-bold mb-3">{item.title}</h3>
                  <p class="text-ink-soft text-sm leading-relaxed">{item.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "process" && process.visible) return (
        <section id="process" class="section-pad bg-canvas">
          <div class="container-content">
            <p class="eyebrow mb-3 reveal">{process.eyebrow}</p>
            <h2 class="mb-12 max-w-2xl reveal">{process.heading}</h2>
            <div class="flex flex-col gap-0">
              {process.steps.map((step, i) => (
                <div class={`grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-8 gap-y-2 py-8 border-t border-line items-start reveal stagger-${i + 1}`}>
                  <div class="flex items-center gap-3 sm:w-48">
                    <span class="numeral text-3xl text-ink/15">{step.num}</span>
                    <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">{step.label}</span>
                  </div>
                  <div>
                    <h3 class="font-display text-lg font-bold mb-2">{step.title}</h3>
                    <p class="text-ink-soft text-sm leading-relaxed max-w-xl">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "whyUs" && whyUs.visible) return (
        <section id="why-us" class="section-pad bg-canvas-deep">
          <div class="container-content">
            <p class="eyebrow mb-3 reveal">{whyUs.eyebrow}</p>
            <h2 class="mb-10 max-w-2xl reveal">{whyUs.heading}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              {whyUs.pillars.map((pillar, i) => (
                <div class={`bg-card border border-line rounded-2xl p-6 reveal stagger-${i + 1}`}>
                  <h3 class="font-display text-lg font-bold mb-3">{pillar.title}</h3>
                  <p class="text-ink-soft text-sm leading-relaxed">{pillar.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      );

      if (sectionId === "credibility" && credibility.visible) return (
        <section id="credibility" class="section-pad bg-dark-section text-white">
          <div class="container-content">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-stretch mb-14">
              <div class="lg:col-span-7 reveal flex flex-col justify-center">
                <p class="eyebrow eyebrow-light mb-3">{credibility.eyebrow}</p>
                <h2 class="text-white mb-6">{credibility.heading}</h2>
                <p class="text-white/80 text-base lg:text-lg leading-relaxed max-w-2xl">
                  {credibility.body}
                </p>
              </div>
              <div class="lg:col-span-5 reveal-scale flex flex-col justify-center">
                <div class="bg-white/5 border border-white/10 rounded-2xl p-4 lg:p-4.5 shadow-xl transition-all duration-300 flex flex-col justify-between">
                  <div class="flex items-center justify-between mb-2 pb-2 border-b border-white/10 gap-2 shrink-0">
                    <div class="flex items-center gap-2">
                      <p class="font-mono text-xs uppercase tracking-wider text-gold-soft font-medium flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                        Ranked Keywords
                      </p>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-up/10 text-up border border-up/20 font-mono text-[10px] uppercase tracking-wider font-semibold">
                        <span class="w-1.5 h-1.5 rounded-full bg-up animate-pulse"></span>
                        Live
                      </span>
                    </div>
                    <button
                      id="rankings-toggle-btn"
                      type="button"
                      aria-expanded="false"
                      aria-controls="rankings-content"
                      class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-lg bg-white/10 hover:bg-gold/20 text-white/80 hover:text-gold-soft border border-white/15 hover:border-gold/30 font-mono text-[10px] font-medium transition-all cursor-pointer group"
                    >
                      <span id="rankings-toggle-label">Expand</span>
                      <svg id="rankings-toggle-icon" class="w-3 h-3 text-gold transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </button>
                  </div>
                  <div id="rankings-summary" class="mb-2 py-1.5 px-2.5 rounded-lg bg-gold/10 border border-gold/20 flex items-center justify-between text-[11px] font-mono shrink-0">
                    <span class="text-gold-soft font-semibold flex items-center gap-1.5">
                      <span class="text-up font-bold">{credibility.keywordsSummary.rankedCount} / {credibility.keywordsSummary.totalCount}</span> Keywords at Rank #1
                    </span>
                    <span class="text-white/60 text-[10px]">{credibility.keywordsSummary.serpLabel}</span>
                  </div>
                  <div
                    id="rankings-content"
                    class="space-y-1.5 overflow-y-auto max-h-[125px] lg:max-h-[135px] pr-1 custom-scrollbar flex-1 min-h-0 transition-all duration-500 relative my-0.5"
                  >
                    {credibility.rankedKeywords.map((kw) => (
                      <div class="py-1.5 px-2.5 rounded-lg bg-white/[0.04] border border-white/10 hover:border-gold/40 hover:bg-white/[0.08] transition-all group">
                        <div class="flex items-center justify-between gap-2 mb-1">
                          <span class="text-[11px] font-medium text-white/90 group-hover:text-gold-soft transition-colors truncate">
                            {kw.keyword}
                          </span>
                          <span class="shrink-0 inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-up/15 text-up border border-up/30 font-mono text-[10px] font-bold shadow-[0_0_6px_rgba(47,143,92,0.25)]">
                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7 7 7M12 3v18"/>
                            </svg>
                            #{kw.rank}
                          </span>
                        </div>
                        <div class="w-full bg-white/10 h-1 rounded-full overflow-hidden">
                          <div class="bg-gradient-to-r from-gold to-up h-full rounded-full" style={`width: ${kw.progress}%;`}></div>
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="mt-2 pt-2 border-t border-white/10 flex items-center justify-between text-[11px] font-mono shrink-0">
                    <button id="rankings-footer-toggle" type="button" class="text-up hover:text-gold-soft uppercase tracking-wider font-semibold flex items-center gap-1 cursor-pointer transition-colors">
                      <span id="rankings-footer-text">↑ Expand All Keywords</span>
                    </button>
                    <span class="text-white/50 text-[10px]">{credibility.keywordsSummary.transparencyLabel}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      );

      if (sectionId === "closingCta" && closingCta.visible) return (
        <section id="contact" class="section-pad bg-canvas-deep text-ink">
          <div class="container-content max-w-2xl">
            <p class="eyebrow mb-3 reveal">{closingCta.eyebrow}</p>
            <h2 class="text-ink mb-4 reveal">{closingCta.heading}</h2>
            <p class="text-ink-soft mb-10 leading-relaxed reveal">
              {closingCta.body}
            </p>
            <form
              id="contact-form"
              class="flex flex-col gap-6 reveal"
              action="mailto:trideep.getusranked@gmail.com"
              method="POST"
              enctype="text/plain"
            >
              <div>
                <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">{closingCta.formLabels.name}</label>
                <input
                  type="text" id="name" name="name" required
                  class="w-full bg-card border border-line-strong rounded-xl text-ink px-4 py-2.5 text-sm outline-none transition-colors duration-200 focus:border-blue focus:bg-canvas placeholder:text-ink-soft/50"
                  placeholder={closingCta.formPlaceholders.name}
                />
              </div>
              <div>
                <label for="company" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">{closingCta.formLabels.company}</label>
                <input
                  type="text" id="company" name="company" required
                  class="w-full bg-card border border-line-strong rounded-xl text-ink px-4 py-2.5 text-sm outline-none transition-colors duration-200 focus:border-blue focus:bg-canvas placeholder:text-ink-soft/50"
                  placeholder={closingCta.formPlaceholders.company}
                />
              </div>
              <div>
                <label for="website" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">{closingCta.formLabels.website}</label>
                <input
                  type="url" id="website" name="website"
                  class="w-full bg-card border border-line-strong rounded-xl text-ink px-4 py-2.5 text-sm outline-none transition-colors duration-200 focus:border-blue focus:bg-canvas placeholder:text-ink-soft/50"
                  placeholder={closingCta.formPlaceholders.website}
                />
              </div>
              <div>
                <label for="business" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">{closingCta.formLabels.business}</label>
                <textarea
                  id="business" name="business" rows="3"
                  class="w-full bg-card border border-line-strong rounded-xl text-ink px-4 py-2.5 text-sm outline-none transition-colors duration-200 focus:border-blue focus:bg-canvas placeholder:text-ink-soft/50 resize-none"
                  placeholder={closingCta.formPlaceholders.business}
                ></textarea>
              </div>
              <div>
                <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">{closingCta.formLabels.email}</label>
                <input
                  type="email" id="email" name="email" required
                  class="w-full bg-card border border-line-strong rounded-xl text-ink px-4 py-2.5 text-sm outline-none transition-colors duration-200 focus:border-blue focus:bg-canvas placeholder:text-ink-soft/50"
                  placeholder={closingCta.formPlaceholders.email}
                />
              </div>

              {turnstileSiteKey && turnstileSiteKey !== '0x4AAAAAAA...' && (
                <div class="my-1">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-error-callback="onTurnstileError"></div>
                </div>
              )}

              <div id="contact-form-status" class="hidden p-4 rounded-xl text-sm font-medium transition-all duration-200"></div>
              <button id="contact-form-submit" type="submit" class="btn btn-primary text-xs mt-2 self-start flex items-center gap-2">
                <span>{closingCta.formLabels.submitText}</span>
              </button>
            </form>
          </div>
        </section>
      );

      return null;
    })}

  </main>
  <Footer />
</BaseLayout>

<script is:inline>
  window.turnstileBlocked = false;
  function onTurnstileError() {
    window.turnstileBlocked = true;
  }
  function onTurnstileScriptError() {
    window.turnstileBlocked = true;
  }
</script>

{turnstileSiteKey && turnstileSiteKey !== '0x4AAAAAAA...' && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer onerror="onTurnstileScriptError()"></script>
)}

<script>
  function initHomePage() {
    // Scroll-reveal observer — triggers 'revealed' class when elements enter viewport
    const revealElements = document.querySelectorAll('.reveal, .reveal-scale');

    if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.05,
          rootMargin: '0px 0px 50px 0px',
        }
      );

      revealElements.forEach((el) => observer.observe(el));

      // Mobile Safety Fallback: Ensure elements become visible even if IntersectionObserver delays
      setTimeout(() => {
        revealElements.forEach((el) => el.classList.add('revealed'));
      }, 600);
    } else {
      // If reduced motion, make everything visible immediately
      revealElements.forEach((el) => {
        el.classList.add('revealed');
      });
    }

    // Handle Form Submission to Backend API (/api/contact)
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('contact-form-status');
    const submitBtn = document.getElementById('contact-form-submit') as HTMLButtonElement | null;

    if (contactForm) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!submitBtn || !statusDiv) return;

        const formData = new FormData(contactForm);
        const turnstileWidget = contactForm.querySelector('.cf-turnstile');
        const turnstileToken = formData.get('cf-turnstile-response');

        // Pre-validate Turnstile token client-side if widget is present and script isn't blocked by Safari ITP
        if (turnstileWidget && !turnstileToken && !(window as any).turnstileBlocked) {
          statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-amber-500/10 text-amber-600 border border-amber-500/20 block';
          statusDiv.innerHTML = '✕ Please complete the security check (CAPTCHA) above before submitting.';
          return;
        }

        const originalBtnText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-canvas inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Sending...</span>
        `;
        statusDiv.classList.add('hidden');

        try {
          const data = Object.fromEntries(formData.entries());

          if ((window as any).turnstileBlocked) {
            (data as any).turnstileBlocked = true;
          }

          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          const result = await res.json();

          if (res.ok && result.success) {
            statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-emerald-500/10 text-emerald-600 border border-emerald-500/20 block';
            statusDiv.innerHTML = result.message || '✓ Thank you! Your site review request has been sent successfully. Check your inbox for confirmation.';
            contactForm.reset();
          } else {
            statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20 block';
            statusDiv.innerHTML = `✕ ${result.error || 'Something went wrong submitting your request. Please try again.'}`;
          }
        } catch (error) {
          console.error('Submission error:', error);
          statusDiv.className = 'p-4 rounded-xl text-sm font-medium bg-red-500/10 text-red-400 border border-red-500/20 block';
          statusDiv.innerHTML = '✕ Something went wrong submitting your request. Please try again or email us directly.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnText;

          // Reset Cloudflare Turnstile if present
          if (typeof window !== 'undefined' && (window as any).turnstile) {
            try {
              (window as any).turnstile.reset();
            } catch (e) {
              // Ignore reset error if turnstile not active
            }
          }
        }
      });
    }

    // Expand & Contract functionality for Ranked Keywords Card
    const toggleBtn = document.getElementById('rankings-toggle-btn');
    const footerToggle = document.getElementById('rankings-footer-toggle');
    const toggleLabel = document.getElementById('rankings-toggle-label');
    const toggleIcon = document.getElementById('rankings-toggle-icon');
    const rankingsContent = document.getElementById('rankings-content');
    const footerText = document.getElementById('rankings-footer-text');

    let isExpanded = false;

    function toggleRankingsCard() {
      isExpanded = !isExpanded;
      if (rankingsContent) {
        if (isExpanded) {
          rankingsContent.style.maxHeight = rankingsContent.scrollHeight + 'px';
          if (toggleLabel) toggleLabel.textContent = 'Contract';
          if (toggleIcon) toggleIcon.style.transform = 'rotate(180deg)';
          if (footerText) footerText.textContent = '↑ Contract Keywords';
          toggleBtn?.setAttribute('aria-expanded', 'true');
        } else {
          rankingsContent.style.maxHeight = '125px';
          if (toggleLabel) toggleLabel.textContent = 'Expand';
          if (toggleIcon) toggleIcon.style.transform = 'rotate(0deg)';
          if (footerText) footerText.textContent = '↑ Expand All Keywords';
          toggleBtn?.setAttribute('aria-expanded', 'false');
        }
      }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', toggleRankingsCard);
    if (footerToggle) footerToggle.addEventListener('click', toggleRankingsCard);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomePage);
  } else {
    initHomePage();
  }
</script>
