---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/app.css";
import {
  createGraphSchema,
  getOrganizationSchema,
  getWebsiteSchema,
  getWebPageSchema,
  getBreadcrumbSchema,
  SITE_URL,
} from "../utils/schema";

const socialProfiles = [
  {
    platform: "Instagram",
    handle: "@getusranked",
    url: "https://instagram.com/getusranked",
    description: "Follow our agency journey, search experiments, behind-the-scenes builds, and design breakdowns.",
    iconColor: "text-[#E4405F]",
    svg: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" clip-rule="evenodd"/></svg>`,
  },
  {
    platform: "Facebook",
    handle: "GetUsRanked Agency",
    url: "https://facebook.com/getusranked",
    description: "Connect on Facebook for agency announcements, industry updates, and live site teardowns.",
    iconColor: "text-[#1877F2]",
    svg: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/></svg>`,
  },
  {
    platform: "LinkedIn",
    handle: "GetUsRanked",
    url: "https://linkedin.com/company/getusranked",
    description: "Follow on LinkedIn for in-depth SEO strategy articles, technical analysis, and agency milestones.",
    iconColor: "text-[#0A66C2]",
    svg: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/></svg>`,
  },
];

const pageTitle = "GetUsRanked — Contact Our Web Design & Search Visibility Team";
const pageDesc = "Reach out to GetUsRanked for a free site audit, web design consultation, or SEO inquiry. Connect on Instagram, Facebook, and LinkedIn.";

const contactSchema = createGraphSchema([
  getOrganizationSchema(),
  getWebsiteSchema(),
  getWebPageSchema({
    name: pageTitle,
    description: pageDesc,
    url: `${SITE_URL}/contact`,
    type: "ContactPage",
  }),
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Contact Us", url: "/contact" },
  ]),
]);
---

<BaseLayout title={pageTitle} description={pageDesc} schema={contactSchema}>
  <Header />
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="section-pad bg-canvas border-b border-line">
      <div class="container-content">
        <div class="max-w-2xl">
          <p class="eyebrow mb-3 reveal">Contact GetUsRanked</p>
          <h1 class="mb-4 reveal">Let's talk about getting your website ranked.</h1>
          <p class="text-ink-soft text-lg leading-relaxed reveal">
            Have a question, need a custom quote, or want a free audit of your current website? Send us a message or connect through our social channels.
          </p>
        </div>
      </div>
    </section>

    <!-- Social Media Profiles Grid -->
    <section class="section-pad bg-canvas-deep">
      <div class="container-content">
        <div class="mb-8">
          <p class="eyebrow mb-2 reveal">Social Profiles</p>
          <h2 class="reveal">Connect with us online</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {socialProfiles.map((social, i) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`bg-card border border-line rounded-2xl p-6 no-underline hover:border-blue transition-all duration-200 group reveal stagger-${i + 1}`}
            >
              <div class="flex items-center gap-3 mb-4">
                <div class:list={["p-2.5 bg-canvas rounded-xl border border-line transition-transform group-hover:scale-110 duration-200", social.iconColor]} Fragment set:html={social.svg} />
                <div>
                  <h3 class="font-display text-lg font-bold text-ink group-hover:text-blue transition-colors">
                    {social.platform}
                  </h3>
                  <p class="font-mono text-xs text-ink-soft">{social.handle}</p>
                </div>
              </div>
              <p class="text-ink-soft text-sm leading-relaxed mb-4">
                {social.description}
              </p>
              <span class="font-mono text-xs text-blue group-hover:underline flex items-center gap-1 font-medium">
                Visit Profile &rarr;
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Main Contact Form & Direct Info -->
    <section class="section-pad bg-canvas">
      <div class="container-content">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

          <!-- Left Info Column -->
          <div class="lg:col-span-5 reveal">
            <p class="eyebrow mb-3">Direct Contact</p>
            <h2 class="mb-6">Reach out directly</h2>
            <p class="text-ink-soft text-sm leading-relaxed mb-8">
              We respond to all inquiries within 24 business hours. Whether you need a full site build, an SEO audit, or an enterprise web application — you'll speak directly with the team doing the work.
            </p>

            <div class="space-y-6">
              <div class="bg-card border border-line rounded-2xl p-5">
                <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-1">Email</p>
                <a
                  href="mailto:hello@getusranked.com"
                  class="font-display font-bold text-ink hover:text-blue text-base no-underline transition-colors"
                >
                  hello@getusranked.com
                </a>
              </div>

              <div class="bg-card border border-line rounded-2xl p-5">
                <p class="font-mono text-xs uppercase tracking-wider text-ink-soft mb-1">Availability</p>
                <p class="font-display font-bold text-ink text-base">Monday – Friday</p>
                <p class="text-xs text-ink-soft mt-1">9:00 AM – 6:00 PM EST</p>
              </div>
            </div>
          </div>

          <!-- Right Form Column -->
          <div class="lg:col-span-7 bg-card border border-line rounded-2xl p-8 reveal stagger-1">
            <h3 class="font-display text-xl font-bold mb-2">Send us a message</h3>
            <p class="text-ink-soft text-sm mb-6">Fill out the form below and we'll get back to you with an audit or response promptly.</p>

            <form
              id="contact-page-form"
              class="flex flex-col gap-6"
              action="mailto:hello@getusranked.com"
              method="POST"
              enctype="text/plain"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-name" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">Name *</label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    class="w-full bg-canvas border-b border-line-strong text-ink py-2.5 px-4 text-sm outline-none transition-colors duration-200 focus:border-blue placeholder:text-ink-soft/50 rounded-xl"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="contact-email" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">Email *</label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    class="w-full bg-canvas border-b border-line-strong text-ink py-2.5 px-4 text-sm outline-none transition-colors duration-200 focus:border-blue placeholder:text-ink-soft/50 rounded-xl"
                    placeholder="you@company.com"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="contact-company" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">Company / Agency</label>
                  <input
                    type="text"
                    id="contact-company"
                    name="company"
                    class="w-full bg-canvas border-b border-line-strong text-ink py-2.5 px-4 text-sm outline-none transition-colors duration-200 focus:border-blue placeholder:text-ink-soft/50 rounded-xl"
                    placeholder="Company name"
                  />
                </div>
                <div>
                  <label for="contact-website" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">Website URL</label>
                  <input
                    type="url"
                    id="contact-website"
                    name="website"
                    class="w-full bg-canvas border-b border-line-strong text-ink py-2.5 px-4 text-sm outline-none transition-colors duration-200 focus:border-blue placeholder:text-ink-soft/50 rounded-xl"
                    placeholder="https://yourbusiness.com"
                  />
                </div>
              </div>

              <div>
                <label for="contact-message" class="font-mono text-xs uppercase tracking-wider text-ink-soft block mb-2">How can we help? *</label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  class="w-full bg-canvas border-b border-line-strong text-ink py-2.5 px-4 text-sm outline-none transition-colors duration-200 focus:border-blue placeholder:text-ink-soft/50 resize-none rounded-xl"
                  placeholder="Tell us about your project, goals, or current search performance..."
                ></textarea>
              </div>

              <button type="submit" class="btn btn-primary self-start mt-2">
                Send Message
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Scroll-reveal observer
  const revealElements = document.querySelectorAll('.reveal');

  if (revealElements.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px',
      }
    );

    revealElements.forEach((el) => observer.observe(el));
  } else {
    revealElements.forEach((el) => {
      el.classList.add('revealed');
    });
  }
</script>
