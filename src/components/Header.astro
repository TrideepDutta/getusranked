---
import navData from "../data/navigation.json";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
const navLinks = navData.header.navLinks;
const ctaText = navData.header.ctaText;
const ctaHref = navData.header.ctaHref;
---

<header id="site-header" class="fixed top-3 md:top-4 left-3 right-3 md:left-6 md:right-6 max-w-6xl mx-auto z-50">
  <!-- Main Header Bar -->
  <div id="site-header-inner" class="px-5 md:px-7 flex items-center justify-between h-14 md:h-16 glass-header shadow-lg transition-all duration-300">
    <!-- Logo -->
    <a id="site-logo" href="/" class="flex items-center gap-2 no-underline hover:no-underline">
      <span class="font-display font-bold text-xl tracking-tight text-ink">
        GetUs<span class="text-blue">Ranked</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-3 lg:gap-5" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-mono text-xs uppercase tracking-widest no-underline transition-all duration-200 px-3.5 py-1.5 rounded-full",
            currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
              ? "text-blue font-medium bg-blue/10 border border-blue/25 backdrop-blur-sm shadow-[inset_0_1px_1px_rgba(255,255,255,0.7)]"
              : "text-ink-soft hover:text-ink hover:bg-canvas/60 hover:border hover:border-line/40 hover:backdrop-blur-sm",
          ]}
        >
          {link.label}
        </a>
      ))}
      <ThemeToggle />
      <a href={ctaHref} class="btn btn-primary text-xs rounded-full">{ctaText}</a>
    </nav>

    <!-- Mobile Header Actions (Toggle + Mobile Menu Toggle) -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle id="theme-toggle-mobile-header" />
      <button
        id="mobile-menu-toggle"
        class="relative flex items-center justify-center w-10 h-10 cursor-pointer bg-canvas/40 backdrop-blur-md border border-line/40 rounded-full shadow-sm hover:bg-canvas/80 active:scale-90 transition-all duration-300 focus:outline-none"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <!-- Hamburger Icon -->
        <svg id="icon-menu" class="w-5 h-5 text-ink transition-all duration-300 ease-out" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <!-- Close Icon (X) -->
        <svg id="icon-close" class="w-5 h-5 text-ink transition-all duration-300 ease-out" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="md:hidden flex flex-col items-start gap-3 p-5 mt-2.5 border border-line/60 rounded-3xl shadow-2xl origin-top glass-mobile-menu"
  >
    {navLinks.map((link, idx) => (
      <a
        href={link.href}
        style={`transition-delay: ${idx * 35}ms;`}
        class:list={[
          "font-mono text-sm uppercase tracking-widest no-underline transition-all duration-200 w-full py-3 px-4 rounded-full flex items-center justify-between nav-item-animate",
          currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
            ? "text-blue font-medium bg-blue/10 border border-blue/20"
            : "text-ink-soft hover:text-ink hover:bg-canvas/60",
        ]}
      >
        <span>{link.label}</span>
        {currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) ? (
          <span class="w-2 h-2 rounded-full bg-blue"></span>
        ) : null}
      </a>
    ))}
    <div class="w-full pt-2 border-t border-line/40 mt-1 nav-item-animate flex items-center justify-between gap-3" style={`transition-delay: ${navLinks.length * 35}ms;`}>
      <a href={ctaHref} class="btn btn-primary text-xs flex-1 justify-center rounded-full py-3">{ctaText}</a>
      <ThemeToggle id="theme-toggle-mobile-drawer" />
    </div>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-20 md:h-24"></div>

<style>
  /* ── Mobile Toggle Icon Transitions ── */
  #icon-menu,
  #icon-close {
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -10px;
    margin-left: -10px;
  }

  /* Default (Closed) State */
  #site-header #icon-menu {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  #site-header #icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  /* Open State */
  #site-header.is-open #icon-menu {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  #site-header.is-open #icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* ── Mobile Dropdown GPU Accelerated Pop-Out From Burger Icon (Top Right Origin) ── */
  #mobile-menu {
    visibility: hidden;
    opacity: 0;
    transform: scale(0.35) translateY(-20px);
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #site-header.is-open #mobile-menu {
    visibility: visible;
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  /* ── Staggered Cascading Items ── */
  #mobile-menu .nav-item-animate {
    opacity: 0;
    transform: translateX(12px) translateY(-4px);
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #site-header.is-open #mobile-menu .nav-item-animate {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }

  /* ── Mobile Only (max-width: 859px): Navbar slides L→R into burger, R→L out from burger ── */
  @media (max-width: 859px) {
    /* Use flexbox on the header to handle right-alignment without margin-left:auto (which doesn't animate) */
    #site-header {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    #site-header-inner {
      transform-origin: right center;
      will-change: width, height, padding, border-radius, background, box-shadow;
      /* Explicit base state for all transitioned properties so reverse has concrete values */
      width: 100%;
      height: 3.5rem;
      border-radius: 1.5rem; /* matches rounded-3xl-ish from glass-header */
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      /* Single unified transition — same curve & duration for enter AND exit */
      transition:
        width 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        height 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        padding 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        border-radius 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        background 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        border-color 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }

    #site-logo {
      transform-origin: left center;
      will-change: opacity, transform, max-width;
      /* Explicit base values */
      max-width: 220px;
      white-space: nowrap;
      overflow: hidden;
      opacity: 1;
      transform: translateX(0);
      /* Same curve for forward AND reverse — symmetric animation */
      transition:
        opacity 0.38s cubic-bezier(0.4, 0, 0.2, 1),
        transform 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        max-width 0.42s cubic-bezier(0.4, 0, 0.2, 1),
        margin 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Toggle button — base state with explicit transition */
    #mobile-menu-toggle {
      transition:
        background 0.38s cubic-bezier(0.4, 0, 0.2, 1),
        border-color 0.38s cubic-bezier(0.4, 0, 0.2, 1),
        box-shadow 0.38s cubic-bezier(0.4, 0, 0.2, 1),
        backdrop-filter 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Scrolled State: bar collapses L→R into burger circle ── */
    #site-header.is-scrolled:not(.is-open) #site-header-inner {
      width: 3.25rem;
      height: 3.25rem;
      padding-left: 0;
      padding-right: 0;
      justify-content: center;
      border-radius: 9999px;
    }

    /* Logo & mobile header theme toggle slide rightward into the burger icon and fade out when scrolled */
    #site-header.is-scrolled:not(.is-open) #site-logo,
    #site-header.is-scrolled:not(.is-open) #theme-toggle-mobile-header {
      display: none !important;
    }

    #site-header.is-scrolled:not(.is-open) #mobile-menu-toggle {
      background: transparent !important;
      border-color: transparent !important;
      box-shadow: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  }
</style>

<script>
  function initHeader() {
    // Sticky glass header effect + mobile scroll-direction navbar collapse
    const header = document.getElementById("site-header");
    const headerInner = document.getElementById("site-header-inner");

    if (headerInner && header) {
      let lastScrollY = window.scrollY;
      const SCROLL_DEAD_ZONE = 25; // Increase dead zone to prevent tap micro-drags from collapsing header
      const MIN_SCROLL_OFFSET = 60; // Require scrolling past top hero section before collapse triggers
      const MOBILE_BREAKPOINT = 860; // matches @media max-width: 859px

      const onScroll = () => {
        const currentY = window.scrollY;
        const delta = currentY - lastScrollY;

        // Glass effect for desktop (always based on position)
        if (currentY > 10) {
          headerInner.classList.add("glass-header-scrolled");
          headerInner.classList.remove("glass-header");
        } else {
          headerInner.classList.add("glass-header");
          headerInner.classList.remove("glass-header-scrolled");
        }

        // Mobile-only: direction-based collapse into burger icon
        if (window.innerWidth < MOBILE_BREAKPOINT) {
          if (currentY <= MIN_SCROLL_OFFSET) {
            // Near top of page — always show full navbar
            header.classList.remove("is-scrolled");
          } else if (delta > SCROLL_DEAD_ZONE) {
            // Scrolling DOWN significantly → collapse into burger
            header.classList.add("is-scrolled");
          } else if (delta < -SCROLL_DEAD_ZONE) {
            // Scrolling UP significantly → expand back out
            header.classList.remove("is-scrolled");
          }
        }

        lastScrollY = currentY;
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }

    // Pure GPU-accelerated CSS state toggle logic
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");

    if (header && toggle && menu) {
      const toggleMenu = (open?: boolean) => {
        const shouldOpen = open !== undefined ? open : !header.classList.contains("is-open");
        if (shouldOpen) {
          header.classList.add("is-open");
          toggle.setAttribute("aria-expanded", "true");
        } else {
          header.classList.remove("is-open");
          toggle.setAttribute("aria-expanded", "false");
        }
      };

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // Close menu when clicking any link inside it
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

      // Close menu when clicking outside
      document.addEventListener("click", (e) => {
        if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
</script>
