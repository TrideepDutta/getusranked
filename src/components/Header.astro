---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about-us", label: "About Us" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact Us" },
];
---

<header id="site-header" class="fixed top-3 md:top-4 left-3 right-3 md:left-6 md:right-6 max-w-6xl mx-auto z-50 transition-all duration-300 glass-header shadow-lg">
  <div class="px-5 md:px-7 flex items-center justify-between h-14 md:h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 no-underline hover:no-underline">
      <span class="font-display font-bold text-xl tracking-tight text-ink">
        GetUs<span class="text-blue">Ranked</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-3 lg:gap-5" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-mono text-xs uppercase tracking-widest no-underline transition-all duration-200 px-3.5 py-1.5 rounded-full",
            currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
              ? "text-blue font-medium bg-blue/10 border border-blue/25 backdrop-blur-sm shadow-[inset_0_1px_1px_rgba(255,255,255,0.7)]"
              : "text-ink-soft hover:text-ink hover:bg-canvas/60 hover:border hover:border-line/40 hover:backdrop-blur-sm",
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="btn btn-primary text-xs rounded-full">Get a Free Audit</a>
    </nav>

    <!-- Mobile Toggle -->
    <button
      id="mobile-menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 cursor-pointer bg-canvas/40 backdrop-blur-md border border-line/40 rounded-full shadow-sm hover:bg-canvas/80 transition-all"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
    >
      <span class="block w-5 h-px bg-ink transition-transform duration-200 origin-center" id="bar-1"></span>
      <span class="block w-5 h-px bg-ink transition-opacity duration-200" id="bar-2"></span>
      <span class="block w-5 h-px bg-ink transition-transform duration-200 origin-center" id="bar-3"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col items-start gap-4 p-6 mt-2 border border-line/60 rounded-3xl shadow-xl backdrop-blur-xl"
    style="background: rgba(238, 241, 239, 0.92); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%);"
  >
    {navLinks.map(link => (
      <a
        href={link.href}
        class:list={[
          "font-mono text-sm uppercase tracking-widest no-underline transition-colors duration-200 w-full py-2.5 px-4 rounded-full",
          currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href))
            ? "text-blue font-medium bg-blue/10 border border-blue/20"
            : "text-ink-soft hover:text-ink hover:bg-canvas/50",
        ]}
      >
        {link.label}
      </a>
    ))}
    <a href="/contact" class="btn btn-primary text-xs mt-2 w-full justify-center rounded-full">Get a Free Audit</a>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-20 md:h-24"></div>

<script>
  // Sticky glass header effect
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 10) {
        header.classList.add("glass-header-scrolled");
        header.classList.remove("glass-header");
      } else {
        header.classList.add("glass-header");
        header.classList.remove("glass-header-scrolled");
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Mobile menu toggle
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const bar1 = document.getElementById("bar-1");
  const bar2 = document.getElementById("bar-2");
  const bar3 = document.getElementById("bar-3");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.contains("flex");
      if (isOpen) {
        menu.classList.remove("flex");
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
        if (bar1) bar1.style.transform = "none";
        if (bar2) bar2.style.opacity = "1";
        if (bar3) bar3.style.transform = "none";
      } else {
        menu.classList.remove("hidden");
        menu.classList.add("flex");
        toggle.setAttribute("aria-expanded", "true");
        if (bar1) bar1.style.transform = "rotate(45deg) translate(2px, 2px)";
        if (bar2) bar2.style.opacity = "0";
        if (bar3) bar3.style.transform = "rotate(-45deg) translate(2px, -2px)";
      }
    });
  }
</script>
