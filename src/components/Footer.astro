---
import navData from "../data/navigation.json";
import siteData from "../data/site.json";

const quickLinks = navData.footer.quickLinks;
const bottomLinks = navData.footer.bottomLinks;
const socialLinks = siteData.socialLinks;
---

<footer class="bg-ink text-canvas">
  <div class="container-content section-pad">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16">
      <!-- Brand -->
      <div>
        <a href="/" class="no-underline hover:no-underline">
          <span class="font-display font-bold text-xl text-canvas">
            GetUs<span class="text-blue">Ranked</span>
          </span>
        </a>
        <p class="text-canvas/60 text-sm mt-4 leading-relaxed max-w-xs">
          {siteData.brandTagline}
        </p>

        <!-- Social Profiles -->
        <div class="mt-6 flex flex-wrap gap-4">
          {socialLinks.map(s => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-canvas/60 hover:text-canvas text-xs font-mono no-underline transition-colors duration-200"
            >
              {s.label} &rarr;
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="eyebrow eyebrow-light mb-4">Quick Links</h4>
        <nav class="flex flex-col gap-2.5" aria-label="Footer navigation">
          {quickLinks.map(link => (
            <a
              href={link.href}
              class="text-canvas/70 hover:text-canvas text-sm no-underline transition-colors duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="eyebrow eyebrow-light mb-4">Get in Touch</h4>
        <a
          href={`mailto:${siteData.email}`}
          class="text-canvas/70 hover:text-canvas text-sm no-underline transition-colors duration-200 block mb-2"
        >
          {siteData.email}
        </a>
        <div class="mt-6">
          <a href={navData.footer.ctaHref} class="btn btn-ghost-light text-xs">{navData.footer.ctaText}</a>
        </div>
      </div>
    </div>

    <!-- Divider & Copyright -->
    <div class="border-t border-canvas/10 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-canvas/40 text-xs font-mono">
        &copy; {new Date().getFullYear()} {siteData.name}. All rights reserved.
      </p>
      <div class="flex gap-6">
        {bottomLinks.map(link => (
          <a href={link.href} class="text-canvas/40 hover:text-canvas/70 text-xs font-mono no-underline transition-colors duration-200">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
