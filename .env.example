# Google Apps Script Web App URL for contact form submission
PUBLIC_GOOGLE_SHEET_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Gmail SMTP Credentials for Confirmation & Lead Notification Emails
GMAIL_USER="trideep.getusranked@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Resend Email API Key (from https://resend.com)
RESEND_API_KEY="re_123456789_your_api_key"

# Cloudflare Turnstile CAPTCHA Keys (from https://dash.cloudflare.com)
PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# Recipient Email for Lead Notifications
ADMIN_NOTIFICATION_EMAIL="trideep.getusranked@gmail.com"

